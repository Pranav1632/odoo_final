# Copy this file to .env and fill in real values — DO NOT commit .env
DATABASE_URL="postgresql://pp360_user:choose-a-real-password-here@localhost:5432/peoplepay360"
JWT_SECRET="change-this-to-a-minimum-32-character-random-string"
REDIS_HOST="localhost"
REDIS_PORT="6379"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# SMTP (payslip email delivery) — points at Mailpit locally (run `mailpit`,
# view sent mail at http://localhost:8025). Point at a real provider's SMTP
# endpoint in production (e.g. Resend, SendGrid, SES) — no code changes needed.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="payroll@peoplepay360.local"
